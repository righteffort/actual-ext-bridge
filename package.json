{
  "name": "actual-ext-bridge",
  "version": "0.0.1",
  "private": true,
  "description": "Library for Actual Budget browser extensions",
  "homepage": "https://github.com/righteffort/actual-ext-bridge",
  "bugs": {
    "url": "https://github.com/righteffort/actual-ext-bridge/issues/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:righteffort/actual-ext-bridge.git"
  },
  "packageManager": "yarn@4.11.0",
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "bridge:build": "yarn workspace @righteffort/actual-ext-bridge build",
    "example:build": "yarn workspace @righteffort/actual-ext-bridge-example build",
    "build": "yarn bridge:build && yarn example:build",
    "e2e:compile": "yarn tsc",
    "e2e:fake:build": "cd test/fake-actual-site && yarn build",
    "e2e:test": "yarn e2e:fake:build && vitest run test/extension-e2e.test.ts",
    "e2e:test:watch": "yarn e2e:fake:build && vitest test/extension-e2e.test.ts"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "puppeteer": "^23.11.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
